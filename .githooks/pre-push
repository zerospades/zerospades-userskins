#!/bin/bash
# Refuse to push a commit whose message references Claude or AI.
#
# commit-msg guards new commits; this catches what got in another way -- a
# rebase, a merge, a cherry-pick, or a commit made before the hook existed.
set -uo pipefail

source "$(dirname "$0")/no-ai-refs.sh"

ZERO=0000000000000000000000000000000000000000
status=0
scratch="$(mktemp)"
trap 'rm -f "$scratch"' EXIT

while read -r _local_ref local_sha _remote_ref remote_sha; do
	[[ "$local_sha" == "$ZERO" ]] && continue  # a branch being deleted

	if [[ "$remote_sha" == "$ZERO" ]]; then
		# A new branch: check what it adds that no other remote branch has.
		commits=$(git rev-list "$local_sha" --not --remotes 2>/dev/null || true)
	else
		commits=$(git rev-list "$remote_sha..$local_sha" 2>/dev/null || true)
	fi
	[[ -z "$commits" ]] && continue

	while read -r commit; do
		[[ -z "$commit" ]] && continue
		git log -1 --format=%B "$commit" > "$scratch"
		if output=$(ai_refs_in "$scratch"); then
			echo "$commit references Claude or AI:" >&2
			echo "$output" | sed 's/^/    /' >&2
			status=1
		fi
	done <<< "$commits"
done

if (( status )); then
	echo >&2
	echo "Nothing was pushed. Reword these commits, then push again." >&2
	echo "To rewrite the messages:  git rebase -i --root" >&2
fi

exit $status
